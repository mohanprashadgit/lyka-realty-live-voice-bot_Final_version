# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Twilio Voice Outbound Calling Credentials
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# Public Base URL for Twilio Voice Webhook & Media Stream (e.g. ngrok or Cloud Run URL)
PUBLIC_BASE_URL="https://ais-dev-jsafcd2s7y6llgkyifyaox-696402356823.asia-east1.run.app"

# ── MySQL Database Configuration (TiDB Cloud) ─────────────────────────
# Read by db.ts (connection pool) and server.ts (/api/health/db).
# NOTE: if DATABASE_URL is set, it overrides ALL of these DB_* vars.
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=lyka_crm
DB_SSL=true

# ── Server Runtime ────────────────────────────────────────────────────
# Render sets these automatically (see render.yaml) — keep commented locally
# so `npm run dev` keeps Vite HMR enabled and serves on port 3000.
# NODE_ENV=production
# PORT=10000
